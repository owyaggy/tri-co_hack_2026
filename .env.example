# Copy to .env (gitignored) and fill in. Never commit real values.
DO_INFERENCE_URL=https://inference.do-ai.run/v1
DO_INFERENCE_KEY=
DO_MODEL=anthropic-claude-sonnet-5.5
KAGI_API_KEY=

# Spending limits (SPEC §9.1). Per copy: demo AI 10 / search 3, sandbox AI 12 / search 4.
AI_BUDGET_USD=10
SEARCH_BUDGET_USD=3
# Paid Asks per device per hour; 0 = no limit (demo copy).
DEVICE_ASKS_PER_HOUR=0
# 1 = block every paid call on this copy (emergency stop).
AI_OFF=0

# Public copy (explainers/security.md). Set a long random PROFESSOR_PASSWORD there; leave it
# empty for local development (anyone can log in as the professor).
PROFESSOR_PASSWORD=
# 0 = POST /readings is refused and the upload card is hidden.
UPLOADS_ENABLED=1
